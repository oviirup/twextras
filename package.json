{
  "name": "twextras",
  "version": "3.0.3",
  "description": "A collection of useful tailwind plugins and utilities in one package",
  "repository": "oviirup/twextras",
  "license": "MIT",
  "author": "Avirup Ghosh (oviirup)",
  "type": "module",
  "exports": {
    ".": "./dist/index.css",
    "./animate": "./dist/animate.css",
    "./drag": "./dist/drag.css",
    "./slot": "./dist/slot.css",
    "./svg": "./dist/svg.css",
    "./variants": "./dist/variants.css",
    "./cn.config": "./dist/cn.config.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "bun run compile.ts",
    "format": "biome format --write",
    "lint": "biome check",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "lightningcss": "^1.33.0",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "cn": "^0",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "cn": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
